{
    "name": "sistema/cms",
    "description": "Sistema CMS - Framework MVC propio inspirado en Laravel",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/",
            "Lib\\": "lib/",
            "System\\": "System/"
        },
        "files": [
            "lib/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
